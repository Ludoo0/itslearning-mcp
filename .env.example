# itslearning-Instanz und Zugangsdaten (Pflicht)
ITSL_BASE_URL=https://meineschule.itslearning.com
ITSL_USERNAME=
ITSL_PASSWORD=
# Alternativ als Docker-Secrets:
# ITSL_USERNAME_FILE=/run/secrets/itsl_username
# ITSL_PASSWORD_FILE=/run/secrets/itsl_password

# Transport: stdio (Default) | http (ab Meilenstein 4)
MCP_TRANSPORT=stdio
# MCP_PORT=3000
# MCP_API_KEY=            # Pflicht bei http, mind. 32 Zeichen

# Persistenz (Login-Status, Lehrkräfte-Verzeichnis, Datei-Cache)
DATA_DIR=.data
# DOWNLOAD_DIR=downloads   # optional: heruntergeladene Dateien zusätzlich hier ablegen
# MAX_FILE_MB=25

# Optional
# REDACT_TEACHERS=false   # true → Lehrkräfte ebenfalls pseudonymisieren
# CACHE_TTL_S=60
# MAX_CONCURRENCY=2
# MIN_REQUEST_INTERVAL_MS=200
# LOG_LEVEL=info
