# itslearning instance and credentials (required)
ITSL_BASE_URL=https://yourschool.itslearning.com
ITSL_USERNAME=
ITSL_PASSWORD=
# Alternatively as Docker secrets:
# ITSL_USERNAME_FILE=/run/secrets/itsl_username
# ITSL_PASSWORD_FILE=/run/secrets/itsl_password

# Transport: stdio (default, local clients) | http (Streamable HTTP at /mcp)
MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1      # Docker image: 0.0.0.0
# MCP_PORT=3000
# MCP_API_KEY=            # required for http, at least 32 characters
# MCP_ALLOWED_ORIGINS=    # only if browser clients need access (comma-separated)

# Persistence (login state, pseudonym secret, teacher directory, file cache)
DATA_DIR=.data
# DOWNLOAD_DIR=downloads   # optional: also store downloaded files here
# MAX_FILE_MB=25

# Redaction
# REDACTION_LANGUAGE=en    # en | de | nb | sv | nl | fr – labels such as "Me", "Teacher Müller", "Student-7F3A"
# REDACTION_KEEP_WORDS=    # comma-separated words never replaced as a single name
# REDACT_TEACHERS=false    # true → pseudonymise teachers as well
# TEACHER_ROLE_TITLES=Teacher,Staff,Lehrer,Lehrerin,Lehrkraft,Mitarbeiter

# Optional
# CACHE_TTL_S=60
# MAX_CONCURRENCY=2
# MIN_REQUEST_INTERVAL_MS=200
# LOG_LEVEL=info
